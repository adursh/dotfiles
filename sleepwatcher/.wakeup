#!/usr/bin/env bash

# turn on and connect paired devices

set -u

MAX_RETRIES=1
BT_INIT_WAIT=0
RETRY_DELAY=1

BLUEUTIL="/opt/homebrew/bin/blueutil"

log() {
  echo "[BT-RECONNECT] $*"
}

# sleep 6

log "Turning Bluetooth ON"
"$BLUEUTIL" --power 1

log "Waiting for Bluetooth stack..."
sleep "$BT_INIT_WAIT"

devices=$("$BLUEUTIL" --paired | sed -n 's/^address: \([^,]*\).*/\1/p')

for mac in $devices; do
  log "Attempting connection: $mac"

  attempt=1
  while [ $attempt -le $MAX_RETRIES ]; do
    if "$BLUEUTIL" --connect "$mac" 2>/dev/null; then
      log "Connect request sent: $mac"
      break
    else
      log "Attempt $attempt failed: $mac"
      attempt=$((attempt+1))
      sleep "$RETRY_DELAY"
    fi
  done

  if [ $attempt -gt $MAX_RETRIES ]; then
    log "Failed after $MAX_RETRIES attempts: $mac"
  fi

  sleep 1
done

log "Reconnect script finished"

# --- Sketchybar helper restart ---
# stats_provider and macmon (temp) often die or stall during sleep.
# NSWorkspaceDidWakeNotification is unreliable after long sleep,
# so sleepwatcher is the primary wake trigger.
(
  sleep 2
  killall stats_provider 2>/dev/null
  pkill -f temp_provider.sh 2>/dev/null
  pkill -f "macmon pipe" 2>/dev/null
  sleep 1
  nohup stats_provider --cpu usage --memory ram_usage --disk usage --interval 5 > /tmp/stats_provider.log 2>&1 &
  nohup "$HOME/.config/sketchybar/plugins/temp_provider.sh" > /tmp/temp_provider.log 2>&1 &
  sketchybar --trigger system_woke 2>/dev/null
) &
