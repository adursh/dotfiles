<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.battery-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/swift</string>
        <string>SCRIPT_PATH_PLACEHOLDER</string>
    </array>

    <!-- Long-running daemon — no StartInterval needed -->
    <!-- KeepAlive: restart if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>HOME_PLACEHOLDER/.local/log/battery_monitor.log</string>

    <key>StandardErrorPath</key>
    <string>HOME_PLACEHOLDER/.local/log/battery_monitor_err.log</string>
</dict>
</plist>
